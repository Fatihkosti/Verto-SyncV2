{
  "version": "115",
  "direction": "rtl",
  "gridDp": 8,
  "referenceViewportDp": { "width": 360, "height": 800 },
  "font": {
    "family": "Cairo",
    "styles": {
      "headline": { "sizeSp": 24, "lineHeightSp": 34, "weight": 700 },
      "title": { "sizeSp": 18, "lineHeightSp": 28, "weight": 700 },
      "body": { "sizeSp": 14, "lineHeightSp": 22, "weight": 400 },
      "label": { "sizeSp": 12, "lineHeightSp": 18, "weight": 600 }
    }
  },
  "spacingDp": [4, 8, 12, 16, 20, 24, 32, 40, 48, 64],
  "radiiDp": [8, 12, 16, 20, 24, 28],
  "minimumTouchTargetDp": 48,
  "colors": {
    "primary": "#6D5CFF",
    "background": "#F7F8FC",
    "surface": "#FFFFFF",
    "border": "#E6E8F0",
    "textPrimary": "#1A1F36",
    "textSecondary": "#4B556B",
    "textMuted": "#8A93A8",
    "success": "#22C55E",
    "warning": "#F59E0B",
    "error": "#EF4444",
    "information": "#3B82F6",
    "waiting": "#6366F1",
    "offline": "#64748B",
    "permission": "#14B8A6",
    "disabled": "#94A3B8"
  },
  "home": {
    "horizontalPaddingDp": 20,
    "headerActionSizeDp": 48,
    "quickActionMinHeightDp": 84,
    "quickActionVisibleCount": { "normal": 3, "largeText": 2 },
    "pendingCardMinHeightDp": 196,
    "sections": [
      "header",
      "quickActions",
      "pendingActions",
      "activityFeed",
      "floatingPrimaryAction"
    ]
  },
  "acceptance": [
    "All home controls expose TalkBack labels",
    "All interactive targets are at least 48dp",
    "RTL order is preserved",
    "No pure black surface is used in dark mode",
    "Empty, loading, permission and confirmation states use shared components",
    "No screen invents new status colors"
  ]
}
